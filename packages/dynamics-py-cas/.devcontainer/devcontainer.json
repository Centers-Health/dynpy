{
    "name": "Dynpy CAS",
    "dockerComposeFile": [
        "../docker-compose.yml"
    ],
    "service": "dev",
    "workspaceFolder": "/app",
    "shutdownAction": "none",
    "remoteUser": "docker",
    "extensions": [
        "batisteo.vscode-django",
        "eamodio.gitlens",
        "ms-python.vscode-pylance",
        "ms-python.python",
        "GitHub.vscode-pull-request-github"
    ],
    "settings": {
        "python.formatting.provider": "black",
        "python.formatting.blackPath": ".venv/bin/black",
        "python.linting.flake8Enabled": true,
        "python.linting.flake8Path": ".venv/bin/flake8heavened"
    }
}
